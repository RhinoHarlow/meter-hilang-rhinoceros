# Salin menjadi .env lalu sesuaikan
PORT=3000
# Jika diisi, tambah/hapus/impor data wajib memakai API key ini (header x-api-key)
API_KEY=

# Sinkron otomatis dari Google Sheets (File > Bagikan > Publikasikan ke web > pilih tab data > format CSV)
SHEET_CSV_URL=
https://docs.google.com/spreadsheets/d/e/2PACX-1vRXWSCeG7Hh2Ym4LVk1vBBLns9K86f7izOZwTwgtejHIqfGFuhcP6d8qaZlLx6rmBPTImLlNsV_dYZc/pub?gid=526754230&single=true&output=csv
# Sinkron ulang tiap berapa menit (default 5)
SYNC_MINUTES=5
